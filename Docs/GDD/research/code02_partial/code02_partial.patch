+        }
+
+        int MaximumSlotColumns => math.max(2, (int)math.floor((BattleWallLayout.To(CastleHalf) - BattleWallLayout.From(CastleHalf)) / MinimumSlotSpacing) + 1);
+
+        // 이동 중 맡아 둔 자리도 정원에 포함한다. 남는 인원만 원래 성벽에 남긴다
+        int WallRoom(int side)
+        {
+            int occupied = 0;
+            foreach (WallSlot slot in wallSlots[side]) if (slot.Occupant >= 0) occupied++;
+            return math.max(0, math.max(wallSlots[side].Count, SqueezedSlots(side, MaximumSlotColumns).Count) - occupied);
+        }
+
+        void EnsureWallRoom(int side, int incoming)
+        {
+            var occupants = new List<int>();
+            foreach (WallSlot slot in wallSlots[side]) if (slot.Occupant >= 0) occupants.Add(slot.Occupant);
+            int needed = occupants.Count + incoming;
+            if (needed <= wallSlots[side].Count) return;
+            List<WallSlot> expanded = null;
+            for (int columns = math.max(2, (needed + SlotRowInset.Length - 1) / SlotRowInset.Length); columns <= MaximumSlotColumns; columns++)
+            {
+                expanded = SqueezedSlots(side, columns);
+                if (expanded.Count >= needed) break;
+            }
+            if (expanded == null || expanded.Count < needed) throw new System.InvalidOperationException("성벽 최소 간격 초과");
+
+            wallSlots[side] = expanded;
+            for (int k = 0; k < occupants.Count; k++)
+            {
+                int soldier = occupants[k];
+                WallSlot slot = expanded[k];
+                slot.Occupant = soldier;
+                expanded[k] = slot;
+                sSlot[soldier] = side * SlotStride + k;
+                float3 spot = SlotPosition(sSlot[soldier]);
+                StopWalk(soldier);
+                if (sAway[soldier] == 0) sPos[soldier] = spot;
+            }
+            // 먼저 출발한 묶음도 새 자리로 들어오게 한다
+            foreach (GroupMove move in groupMoves)
+            {
+                if (move.TargetSide != side) continue;
+                SquadInfo squad = squads[move.Group];
+                for (int k = 0; k < squad.Alive; k++)
+                {
+                    int soldier = squad.FirstSoldier + k;
+                    move.EndSpot[k] = HomeSpot(soldier);
+                    float endU = RingU(side, math.dot(move.EndSpot[k], WallGeometry.Right(side)));
+                    move.Distance[k] = Mod(move.Direction[k] * (endU - move.StartU[k]), CastleHalf * 8f);
+                }
+            }
+            foreach (Messenger messenger in messengers)
+                if (sSlot[messenger.Soldier] / SlotStride == side) messenger.Home = HomeSpot(messenger.Soldier);
+            foreach (RunnerPair pair in runners)
+            {
+                if (pair == null) continue;
+                for (int k = 0; k < pair.Soldiers.Length; k++)
+                    if (pair.Soldiers[k] >= 0 && sSlot[pair.Soldiers[k]] / SlotStride == side) pair.Home[k] = HomeSpot(pair.Soldiers[k]);
+            }
+            SoldiersDirty = true;
+        }
