MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0268e8913dd84207865c3fdbe8b9fdeb, type: 3}
  m_Name: story_fortress1_arrive
  m_EditorClassIdentifier: 
  id: story_fortress1_arrive
  title: "요새 1 도착"
  kind: 0
  note: "Story_Beacon_v1 2장. TODO: 하겐 초상은 임시(궁수 초상). 새 그림이 오면 StoryArt/portrait_hagen_neutral.png 파일만 덮어쓴다."
  scenes:
  - name: "첫 번째 등대 요새"
    background: {fileID: 2800000, guid: b7c1d2e3f4a54b6c8d9e0f1a2b3c4d5e, type: 3}
    lines:
    - speaker: ""
      side: 0
      portrait: {fileID: 0}
      cell: 0
      text: "안개 속 첫 번째 등대 요새. 성벽은 반쯤 무너지고, 탑의 불은 오래전에 꺼져 있었다."
      background: {fileID: 0}
      effect: 2
    - speaker: "하겐"
      side: 2
      portrait: {fileID: 2800000, guid: c6ff621d6fae4e329156fbdb88091de1, type: 3}
      cell: 1
      text: "해가 지면 안개가 짙어집니다. 그 전에 성벽부터."
      background: {fileID: 0}
      effect: 0
    - speaker: "루멘"
      side: 1
      portrait: {fileID: 2800000, guid: 2e502276545c4c80b8eb7e5de2dfb902, type: 3}
      cell: 0
      text: "탑에 불을 올리면 놈들이 몰려오겠네요."
      background: {fileID: 0}
      effect: 0
    - speaker: "이그나"
      side: 2
      portrait: {fileID: 2800000, guid: 7fe0bfc0b6d84809b17818291c3b986e, type: 3}
      cell: 0
      text: "빛을 싫어하니까요. 그래도 켜야 안개가 걷혀요."
      background: {fileID: 0}
      effect: 0
    - speaker: "루멘"
      side: 1
      portrait: {fileID: 2800000, guid: 7250f7a6eb1c4e14893d87ceb074d5e3, type: 3}
      cell: 0
      text: "두 밤만 버티면 이 탑에 불을 끝까지 올릴 수 있어요. 다들 성벽 위로! 같이 버텨요."
      background: {fileID: 0}
      effect: 1
