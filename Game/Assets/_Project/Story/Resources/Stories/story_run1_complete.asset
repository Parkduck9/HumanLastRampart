  m_Script: {fileID: 11500000, guid: 0268e8913dd84207865c3fdbe8b9fdeb, type: 3}
  m_Name: story_run1_complete
  m_EditorClassIdentifier: 
  id: story_run1_complete
  title: "1회차 끝 (요새 2 점화)"
  kind: 2
  note: "Story_Beacon_v1 6장. TODO: 하겐 초상은 임시(궁수 초상). 새 그림이 오면 StoryArt/portrait_hagen_neutral.png 파일만 덮어쓴다."
  scenes:
  - name: "빛의 길"
    background: {fileID: 2800000, guid: c8d2e3f4a5b64c7d9eaf1b2c3d4e5f6a, type: 3}
    lines:
    - speaker: ""
      side: 0
      portrait: {fileID: 0}
      cell: 0
      text: "두 번째 빛기둥이 솟았다. 두 등대 사이로 가는 빛의 길이 이어졌다."
      background: {fileID: 0}
      effect: 2
    - speaker: "하겐"
      side: 2
      portrait: {fileID: 2800000, guid: c6ff621d6fae4e329156fbdb88091de1, type: 3}
      cell: 0
      text: "봉화선이 다시 이어졌습니다. 몇십 년 만에."
      background: {fileID: 0}
      effect: 0
    - speaker: "루멘"
      side: 1
      portrait: {fileID: 2800000, guid: 2e502276545c4c80b8eb7e5de2dfb902, type: 3}
      cell: 0
      text: "아직 두 개뿐이에요. 대륙 끝까지 이으려면 한참 남았죠."
      background: {fileID: 0}
      effect: 0
    - speaker: "이그나"
      side: 2
      portrait: {fileID: 2800000, guid: 8523da93e5604545a6375845831d6f27, type: 3}
      cell: 0
      text: "그럼 계속 가요. 불은 제가 지킬게요."
      background: {fileID: 0}
      effect: 0
    - speaker: ""
      side: 0
      portrait: {fileID: 0}
      cell: 0
      text: "빛을 잇는 자들의 원정은 이제 시작이다."
      background: {fileID: 0}
      effect: 0
