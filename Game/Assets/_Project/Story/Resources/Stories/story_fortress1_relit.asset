  m_Script: {fileID: 11500000, guid: 0268e8913dd84207865c3fdbe8b9fdeb, type: 3}
  m_Name: story_fortress1_relit
  m_EditorClassIdentifier: 
  id: story_fortress1_relit
  title: "요새 1 점화"
  kind: 0
  note: "Story_Beacon_v1 4장. TODO: 하겐 초상은 임시(궁수 초상). 새 그림이 오면 StoryArt/portrait_hagen_neutral.png 파일만 덮어쓴다."
  scenes:
  - name: "첫 번째 빛기둥"
    background: {fileID: 2800000, guid: c8d2e3f4a5b64c7d9eaf1b2c3d4e5f6a, type: 3}
    lines:
    - speaker: ""
      side: 0
      portrait: {fileID: 0}
      cell: 0
      text: "탑 꼭대기에서 빛기둥이 솟았다. 검은 안개가 찢어지며 물러났다."
      background: {fileID: 0}
      effect: 2
    - speaker: "이그나"
      side: 2
      portrait: {fileID: 2800000, guid: f1e38ef38d8a479a9c5d0cd362f63c72, type: 3}
      cell: 0
      text: "켜졌어요……! 정말로."
      background: {fileID: 0}
      effect: 0
    - speaker: "하겐"
      side: 2
      portrait: {fileID: 2800000, guid: c6ff621d6fae4e329156fbdb88091de1, type: 3}
      cell: 1
      text: "수비대를 남기겠습니다. 이 불은 우리가 지킵니다. 대장님은 다음 등대로."
      background: {fileID: 0}
      effect: 0
    - speaker: "루멘"
      side: 1
      portrait: {fileID: 2800000, guid: 7250f7a6eb1c4e14893d87ceb074d5e3, type: 3}
      cell: 0
      text: "하나…… 이제 하나 켰어요."
      background: {fileID: 0}
      effect: 0
